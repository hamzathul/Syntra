generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

enum ItemType {
  GOODS
  SERVICE
}

enum DiscountType {
  AMOUNT
  PERCENTAGE
}

enum OpeningBalanceType {
  TO_PAY
  TO_RECEIVE
}

enum AdjustmentType {
  INCREASE
  DECREASE
}

enum SaleType {
  CASH
  CREDIT
}

enum PaymentMode {
  CASH
  CHEQUE
  BANK
}

enum ChequeStatus {
  RECEIVED
  DEPOSITED_BANK
  DEPOSITED_CASH
  BOUNCED
}

model Company {
  id               String   @id @default(cuid())
  name             String
  gstin            String?
  phone1           String?
  phone2           String?
  email            String?
  address          String?
  pincode          String?
  description      String?
  signature        String?
  state            String?
  businessType     String?
  businessCategory String?
  logo             String?
  showOnCard       Json?    @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  members   CompanyMember[]
  settings  CompanySettings?
  taxRates  TaxRate[]
  taxGroups TaxGroup[]
  units     Unit[]
  categories ItemCategory[]
  items     Item[]
  parties   Party[]
  banks     Bank[]
  cashAccount CashAccount?
  cashAdjustments CashAdjustment[]
  bankAdjustments BankAdjustment[]
  moneyTransfers  MoneyTransfer[]
  sales     Sale[]
  salePayments SalePayment[]
  cheques   Cheque[]
}

model CompanySettings {
  id                  String   @id @default(cuid())
  companyId           String   @unique
  businessCurrency    String   @default("INR")
  decimalPlaces       Int      @default(2)
  dateFormat          String   @default("DD/MM/YYYY")
  stateOfSupplyEnabled Boolean @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model TaxRate {
  id        String   @id @default(cuid())
  companyId String
  name      String
  rate      Decimal  @db.Decimal(5, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  groupRates       TaxGroupRate[]
  items            Item[]

  @@unique([companyId, name])
}

model TaxGroup {
  id        String   @id @default(cuid())
  companyId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  groupRates TaxGroupRate[]
  items      Item[]

  @@unique([companyId, name])
}

model TaxGroupRate {
  taxGroupId String
  taxRateId  String

  taxGroup TaxGroup @relation(fields: [taxGroupId], references: [id], onDelete: Cascade)
  taxRate  TaxRate  @relation(fields: [taxRateId], references: [id], onDelete: Cascade)

  @@id([taxGroupId, taxRateId])
}

model CompanyMember {
  id        String     @id @default(cuid())
  userId    String
  companyId String
  role      MemberRole @default(OWNER)
  isDefault Boolean    @default(false)
  joinedAt  DateTime   @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
}

model Unit {
  id        String   @id @default(cuid())
  companyId String
  name      String
  shortName String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company           Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  primaryItems      Item[]  @relation("ItemPrimaryUnit")
  secondaryItems    Item[]  @relation("ItemSecondaryUnit")

  @@unique([companyId, name])
}

model ItemCategory {
  id        String   @id @default(cuid())
  companyId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  items   Item[]

  @@unique([companyId, name])
}

model Item {
  id                      String       @id @default(cuid())
  companyId               String
  name                    String
  itemType                ItemType     @default(GOODS)
  itemCode                String?
  barcode                 String?
  categoryId              String?
  hsnSac                  String?
  description             String?
  image                   String?
  unitPrimaryId           String
  unitSecondaryId         String?
  unitConversionRate      Decimal?     @db.Decimal(15, 4)
  salePriceExclTax        Decimal?     @db.Decimal(15, 4)
  salePriceInclTax        Decimal?     @db.Decimal(15, 4)
  saleDiscountType        DiscountType?
  saleDiscountValue       Decimal?     @db.Decimal(15, 4)
  purchasePriceExclTax    Decimal?     @db.Decimal(15, 4)
  purchasePriceInclTax    Decimal?     @db.Decimal(15, 4)
  taxRateId               String?
  taxGroupId              String?
  openingStock            Decimal?     @db.Decimal(15, 4)
  openingStockDate        DateTime?
  openingStockValuePerUnit Decimal?    @db.Decimal(15, 4)
  minStockQuantity        Decimal?     @db.Decimal(15, 4)
  location                String?
  createdAt               DateTime     @default(now())
  updatedAt               DateTime     @updatedAt

  company       Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  category      ItemCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  unitPrimary   Unit          @relation("ItemPrimaryUnit", fields: [unitPrimaryId], references: [id], onDelete: Restrict)
  unitSecondary Unit?         @relation("ItemSecondaryUnit", fields: [unitSecondaryId], references: [id], onDelete: Restrict)
  taxRate       TaxRate?      @relation(fields: [taxRateId], references: [id], onDelete: SetNull)
  taxGroup      TaxGroup?     @relation(fields: [taxGroupId], references: [id], onDelete: SetNull)

  @@unique([companyId, name])
  @@unique([companyId, itemCode])
  @@unique([companyId, barcode])
  @@index([companyId])
}

model Party {
  id                   String             @id @default(cuid())
  companyId            String
  name                 String
  contactNumber        String?
  openingBalanceAmount Decimal?           @db.Decimal(15, 4)
  openingBalanceType   OpeningBalanceType?
  openingBalanceDate   DateTime?
  creditLimit          Decimal?           @db.Decimal(15, 4)
  billingAddress       String?
  email                String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sales   Sale[]

  @@unique([companyId, name])
  @@index([companyId])
}

model Bank {
  id                 String   @id @default(cuid())
  companyId          String
  name               String
  openingBalance     Decimal? @db.Decimal(15, 4)
  currentBalance     Decimal  @default(0) @db.Decimal(15, 4)
  openingBalanceDate DateTime?
  printBankDetails   Boolean  @default(false)
  accountHolderName  String?
  accountNumber      String?
  ifscCode           String?
  branchName         String?
  printUpiQr         Boolean  @default(false)
  upiId              String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  company           Company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  adjustments       BankAdjustment[]
  incomingTransfers MoneyTransfer[]  @relation("TransferTo")
  outgoingTransfers MoneyTransfer[]  @relation("TransferFrom")
  payments          SalePayment[]
  chequeDeposits    Cheque[]

  @@unique([companyId, name])
  @@index([companyId])
}

model CashAccount {
  id             String   @id @default(cuid())
  companyId      String   @unique
  currentBalance Decimal  @default(0) @db.Decimal(15, 4)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model CashAdjustment {
  id          String        @id @default(cuid())
  companyId   String
  date        DateTime
  type        AdjustmentType
  amount      Decimal       @db.Decimal(15, 4)
  description String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, date])
}

model BankAdjustment {
  id          String        @id @default(cuid())
  companyId   String
  bankId      String
  date        DateTime
  type        AdjustmentType
  amount      Decimal       @db.Decimal(15, 4)
  description String?
  image       String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bank    Bank    @relation(fields: [bankId], references: [id], onDelete: Cascade)

  @@index([companyId, date])
  @@index([bankId, date])
}

model MoneyTransfer {
  id          String   @id @default(cuid())
  companyId   String
  date        DateTime
  amount      Decimal  @db.Decimal(15, 4)
  fromBankId  String?
  toBankId    String?
  description String?
  image       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  company  Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fromBank Bank?   @relation("TransferFrom", fields: [fromBankId], references: [id], onDelete: SetNull)
  toBank   Bank?   @relation("TransferTo", fields: [toBankId], references: [id], onDelete: SetNull)

  @@index([companyId, date])
  @@index([fromBankId])
  @@index([toBankId])
}

model Sale {
  id             String    @id @default(cuid())
  companyId      String
  partyId        String
  saleType       SaleType
  saleDate       DateTime
  totalAmount    Decimal   @db.Decimal(15, 4)
  receivedAmount Decimal   @db.Decimal(15, 4) @default(0)
  description    String?
  image          String?
  document       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  company  Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  party    Party          @relation(fields: [partyId], references: [id], onDelete: Restrict)
  payments SalePayment[]
  cheques  Cheque[]

  @@index([companyId, saleDate])
  @@index([companyId, partyId])
}

model SalePayment {
  id          String      @id @default(cuid())
  saleId      String
  companyId   String
  mode        PaymentMode
  amount      Decimal     @db.Decimal(15, 4)
  bankId      String?
  description String?
  createdAt   DateTime    @default(now())

  sale   Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  bank   Bank?   @relation(fields: [bankId], references: [id], onDelete: SetNull)
  cheque Cheque?
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([companyId])
}

model Cheque {
  id            String        @id @default(cuid())
  companyId     String
  salePaymentId String        @unique
  saleId        String
  drawBankName  String
  chequeNumber  String
  chequeDate    DateTime
  amount        Decimal       @db.Decimal(15, 4)
  status        ChequeStatus  @default(RECEIVED)
  depositBankId String?
  depositedAt   DateTime?
  notes         String?
  image         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  sale        Sale         @relation(fields: [saleId], references: [id], onDelete: Cascade)
  salePayment SalePayment  @relation(fields: [salePaymentId], references: [id], onDelete: Cascade)
  depositBank Bank?        @relation(fields: [depositBankId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
}
