generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum MemberRole {
  OWNER
  ADMIN
  MEMBER
}

model Company {
  id               String   @id @default(cuid())
  name             String
  gstin            String?
  phone1           String?
  phone2           String?
  email            String?
  address          String?
  pincode          String?
  description      String?
  signature        String?
  state            String?
  businessType     String?
  businessCategory String?
  logo             String?
  showOnCard       Json?    @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  members   CompanyMember[]
  settings  CompanySettings?
  taxRates  TaxRate[]
  taxGroups TaxGroup[]
}

model CompanySettings {
  id                  String   @id @default(cuid())
  companyId           String   @unique
  businessCurrency    String   @default("INR")
  decimalPlaces       Int      @default(2)
  dateFormat          String   @default("DD/MM/YYYY")
  stateOfSupplyEnabled Boolean @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

model TaxRate {
  id        String   @id @default(cuid())
  companyId String
  name      String
  rate      Decimal  @db.Decimal(5, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company          Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  groupRates       TaxGroupRate[]

  @@unique([companyId, name])
}

model TaxGroup {
  id        String   @id @default(cuid())
  companyId String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company    Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  groupRates TaxGroupRate[]

  @@unique([companyId, name])
}

model TaxGroupRate {
  taxGroupId String
  taxRateId  String

  taxGroup TaxGroup @relation(fields: [taxGroupId], references: [id], onDelete: Cascade)
  taxRate  TaxRate  @relation(fields: [taxRateId], references: [id], onDelete: Cascade)

  @@id([taxGroupId, taxRateId])
}

model CompanyMember {
  id        String     @id @default(cuid())
  userId    String
  companyId String
  role      MemberRole @default(OWNER)
  isDefault Boolean    @default(false)
  joinedAt  DateTime   @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
  @@index([userId])
}
