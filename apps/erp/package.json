{
  "name": "erp",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --ignore-watch=src/generated src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:migrate:prod": "prisma migrate deploy",
    "db:reset": "prisma migrate reset",
    "db:generate": "prisma generate",
    "db:studio": "prisma studio",
    "db:status": "prisma migrate status"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "@types/express": "^4.17.21",
    "axios": "^1.7.2",
    "jose": "^6.2.3",
    "backend-p": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^8.0.0",
    "pg": "^8.0.0",
    "pino": "^9.1.0",
    "pino-pretty": "^11.1.0",
    "shared": "workspace:*",
    "ts-node-dev": "^2.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.12.12",
    "@types/pg": "^8.0.0",
    "eslint": "^9.39.1",
    "prisma": "7.8.0",
    "typescript": "^5.4.5"
  }
}
