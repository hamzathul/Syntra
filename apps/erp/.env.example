PORT=3002
LOG_LEVEL=info
LOG_DIR=logs
NODE_ENV=development

CORE_API_URL=http://localhost:3001

CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgres://syntra:syntra-dev@localhost:5432/erp

# Invoice email (POST /api/v1/sales/:id/send-invoice).
# EMAIL_PROVIDER selects the implementation: smtp | resend | log.
# "log" only writes to the log — safe default for local development.
EMAIL_PROVIDER=log
EMAIL_FROM_NAME=Syntra ERP
# Optional override for the sender address. When empty, the company's
# own email is used — configure one in company settings first.
# EMAIL_FROM_ADDRESS=billing@example.com

# Required only when EMAIL_PROVIDER=smtp (any SMTP host works).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Required only when EMAIL_PROVIDER=resend.
RESEND_API_KEY=
