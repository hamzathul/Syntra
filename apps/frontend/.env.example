# Frontend (Next.js, port 3000) — server-side BFF proxy targets.
# The browser never calls backends directly; these feed app/api/proxy/* routes.
# Defaults in code (route.ts) match the values below — uncomment to override.
CORE_API_URL=http://localhost:3001/api/v1
ERP_API_URL=http://localhost:3002/api/v1
AI_API_URL=http://localhost:3003/api/v1
